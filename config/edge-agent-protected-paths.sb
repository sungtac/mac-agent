; Edge Agent provider boundary: allow normal provider operation, but deny
; write-like operations inside Team OS-owned paths. Child CLI processes inherit
; this profile from the launchd-managed provider bridge.
(version 1)
(allow default)
(deny file-write* (subpath "/Users/edge_ai/.openclaw/workspace/team_os"))
(deny file-write* (subpath "/Users/edge_ai/.openclaw/workspace/state"))
(deny file-write* (subpath "/Users/edge_ai/.openclaw/workspace/sukja_telegram"))
