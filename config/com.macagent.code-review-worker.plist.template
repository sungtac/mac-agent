<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.macagent.code-review-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/edge_ai/mac-agent/bin/code-review-worker-runner.js</string>
    <string>--config</string>
    <string>/Users/edge_ai/mac-agent/config/code-review-repositories.json</string>
    <string>--execute</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/edge_ai/.edge-agent/logs/code-review-worker.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/edge_ai/.edge-agent/logs/code-review-worker.err.log</string>
</dict>
</plist>
