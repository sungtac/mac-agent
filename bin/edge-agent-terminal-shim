#!/usr/bin/env bash
set -euo pipefail

ROLE="${EDGE_AGENT_SHIM_ROLE:-$(basename "$0")}"
ROOT="${EDGE_AGENT_ROOT:-$HOME/mac-agent}"
PYTHON="${EDGE_AGENT_PYTHON:-/opt/homebrew/bin/python3}"
REAL=""
case "$ROLE" in
  claude) REAL="${CLAUDE_REAL_BIN:-$HOME/.local/bin/claude}" ;;
  codex) REAL="${CODEX_REAL_BIN:-/opt/homebrew/bin/codex}" ;;
  agy) REAL="${AGY_REAL_BIN:-$HOME/.local/bin/agy}" ;;
  *) echo "unsupported terminal provider shim: $ROLE" >&2; exit 64 ;;
esac

prompt=""
if [ "$ROLE" = claude ]; then
  args=("$@")
  for ((i=0; i<${#args[@]}-1; i++)); do
    if [ "${args[$i]}" = "-p" ] || [ "${args[$i]}" = "--prompt" ]; then prompt="${args[$((i+1))]}"; break; fi
  done
elif [ "$ROLE" = codex ]; then
  args=("$@")
  for ((i=0; i<${#args[@]}-1; i++)); do
    if [ "${args[$i]}" = "--" ]; then prompt="${args[$((i+1))]}"; break; fi
  done
elif [ "$ROLE" = agy ]; then
  args=("$@")
  for ((i=0; i<${#args[@]}-1; i++)); do
    if [ "${args[$i]}" = "--print" ]; then prompt="${args[$((i+1))]}"; break; fi
  done
fi

if [ -n "$prompt" ] && [ -x "$ROOT/bin/edge-agent-provider.sh" ]; then
  tmp="$(mktemp "${TMPDIR:-/tmp}/edge-agent-prompt.XXXXXX")"
  trap 'rm -f "$tmp"' EXIT
  printf '%s\n' "$prompt" > "$tmp"
  exec "$ROOT/bin/edge-agent-provider.sh" "$ROLE" "$tmp" "$PWD"
fi

# Native interactive sessions receive the same bounded contract/session
# context, while continuing to use the provider's own interactive UI.
TASK_ID="${EDGE_AGENT_TASK_ID:-terminal-interactive-${ROLE}-$(printf '%s' "$PWD" | shasum -a 256 | cut -c1-12)}"
SESSION_ID="${EDGE_AGENT_LOGICAL_SESSION_ID:-}"
if [ -z "$SESSION_ID" ] && [ -f "$ROOT/bin/edge_agent_session_bridge.py" ]; then
  SESSION_ID="$("$PYTHON" "$ROOT/bin/edge_agent_session_bridge.py" start "$TASK_ID" "$ROLE" "$PWD")"
fi
CONTEXT=""
if [ -n "$SESSION_ID" ]; then
  CONTEXT="$("$PYTHON" "$ROOT/bin/edge_agent_session_bridge.py" context "$SESSION_ID")"
fi

set +e
case "$ROLE" in
  claude)
    # Management subcommands do not start a model session. Appending the
    # session-context flag to them makes otherwise valid commands such as
    # `claude auth status` fail with "unknown option --append-system-prompt".
    # Pass those commands through untouched; only an interactive/model
    # invocation receives the bounded context.
    case "${1:-}" in
      auth|agents|doctor|help|install|mcp|plugin|update|uninstall|--help|-h|--version|-v)
        "$REAL" "$@"
        ;;
      *)
        "$REAL" "$@" --append-system-prompt "$CONTEXT"
        ;;
    esac
    RC=$?
    ;;
  codex)
    "$REAL" "$@" "$CONTEXT"
    RC=$?
    ;;
  agy)
    "$REAL" "$@" --prompt-interactive "$CONTEXT"
    RC=$?
    ;;
  *)
    "$REAL" "$@"
    RC=$?
    ;;
esac
set -e

if [ -n "$SESSION_ID" ]; then
  "$PYTHON" "$ROOT/bin/edge_agent_session_bridge.py" finish "$SESSION_ID" "$([ "$RC" -eq 0 ] && echo succeeded || echo failed)" || true
fi
exit "$RC"
